<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 可选的导出方法:
         - development: 仅用于测试，需要安装到开发者的设备
         - ad-hoc: 可以直接分享给用户安装（需要上传到分发平台）
         - enterprise: 企业分发（需要企业证书）
         - app-store: App Store发布 -->
    
    <key>method</key>
    <string>development</string>
    
    <key>uploadBitcode</key>
    <false/>
    
    <key>compileWithoutDebugSymbols</key>
    <true/>
    
    <key>stripSwiftSymbols</key>
    <true/>
    
    <key>signingStyle</key>
    <string>manual</string>
    
    <key>provisioningProfiles</key>
    <dict>
        <key>*</key><string>Your Provisioning Profile Name</string>
    </dict>
    
    <key>signingCertificate</key>
    <string>iOS Development</string>
    
    <key>teamID</key>
    <string>Your Team ID</string>
    
    <key>updateCodeSign</key>
    <true/>
</dict>
</plist>